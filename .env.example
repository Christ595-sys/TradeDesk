# PostgreSQL app connection. For Neon/serverless hosting, use the pooled connection URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate a strong secret locally with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Local development:
NEXTAUTH_URL="http://localhost:3000"
# On Vercel, set NEXTAUTH_URL in the Production environment to your production URL,
# for example: https://your-project.vercel.app

# One-time local admin seed only. Do not commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Added automatically in Vercel after connecting the private Blob store.
# Also keep it in local .env so signed screenshot upload/download URLs work in development.
BLOB_READ_WRITE_TOKEN=
